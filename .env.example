# Copy to .env for local development with: npm run dev
# On Netlify, set these in Site settings > Environment variables (never commit .env)

TOLLRING_USERNAME=your.email@service4service.co.uk
TOLLRING_TOKEN=your_tollring_token_id
TOLLRING_BASE=https://your-company.icallsuite.com/api/v4

# Set true to force demo data locally (optional)
DEMO_MODE=false
