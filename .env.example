# Local dev only - set these as environment variables in Netlify dashboard for production
# Never commit this file

TOLLRING_USERNAME=your-icallsuite-email@domain.com
TOLLRING_TOKEN=your-token-string-here

# Weekend missed-call report (Monday 7:00 UTC cron)
REPORT_EMAIL_FROM=reports@yourdomain.com
REPORT_EMAIL_TO=ops@yourdomain.com,night@yourdomain.com
RESEND_API_KEY=re_xxxxxxxx

# Optional notifications
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
GOOGLE_SHEET_WEBHOOK_URL=

# Optional: protect manual report API (/api/weekend-missed)
WEEKEND_REPORT_SECRET=
